{
  "name": "vietsub-video-studio-monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "worker",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:worker": "npm run dev --workspace=worker",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:all": "npx concurrently \"npm run dev:backend\" \"npm run dev:worker\" \"npm run dev:frontend\""
  }
}
